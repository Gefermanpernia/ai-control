<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace @HOME@ with your home directory (see INSTALL.md); launchd does not expand ~. -->
<plist version="1.0"><dict>
<key>Label</key><string>com.ai-control.omniwm-bridge</string>
<key>ProgramArguments</key><array>
<string>/usr/bin/python3</string>
<string>@HOME@/Library/Application Support/aic-omniwm-bridge/bridge.py</string>
</array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>@HOME@/Library/Logs/aic-omniwm-bridge.log</string>
<key>StandardErrorPath</key><string>@HOME@/Library/Logs/aic-omniwm-bridge.log</string>
</dict></plist>
