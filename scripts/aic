#!/bin/sh
# Short launcher for live Claude login switching.
#   aic               open the menu-bar app (macOS) or terminal UI (Linux)
#   aic tui           open the terminal UI on either platform
#   aic save <name>   save the login Claude is using now
#   aic use <name>    switch Claude to a saved login
#   aic login <name> [email]  sign in to another Claude account and save it
#   aic list | rename <name> <new-name> | recover | renew <name>
#   aic usage                 usage of every saved Claude and Codex login
#   aic status [--json] [--usage]   machine-readable login status
#   aic settings [set <key> <value>]  show or change refresh and automatic switching options
#   aic auto-switch check [--background] | order <claude|codex> | move <claude|codex> <name> up|down
#   aic codex save|use|list|rename ...   the same for Codex
#   aic codex login <name>               sign in to another Codex account safely and save it
set -eu
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -x "$here/../MacOS/AIControl" ]; then
    binary="$here/../MacOS/AIControl"              # inside AI Control.app
elif [ -x "$here/AIControl" ]; then
    binary="$here/AIControl"                       # Linux package
else
    binary="$here/../.build/debug/AIControl"       # source checkout
fi
# Test-only engine substitution keeps login smoke tests away from real credentials.
if [ -n "${AIC_TEST_BINARY:-}" ]; then binary=$AIC_TEST_BINARY; fi
export AI_CONTROL_CLAUDE_LIVE=1

# Tests override the fallback root and mount table without requiring a real WSL drive.
windows_mount_root=${AIC_TEST_WINDOWS_MOUNT_ROOT:-/mnt}
# AIC_TEST_MOUNTS is a test-only path to a substitute /proc/self/mounts file.
mount_table=${AIC_TEST_MOUNTS:-/proc/self/mounts}
windows_mounts=
if [ -f "$mount_table" ]; then
    windows_mounts=$(awk '
        $3 == "drvfs" || ($3 == "9p" && $4 ~ /(^|,)aname=drvfs(;|,|$)/) {
            mount = $2
            gsub(/\\040/, " ", mount)
            gsub(/\\011/, "\t", mount)
            gsub(/\\012/, "\n", mount)
            gsub(/\\134/, "\\", mount)
            print mount
        }
    ' "$mount_table")
fi
is_windows_path() {
    case $1 in
        *.[eE][xX][eE]|*.[cC][mM][dD]|*.[bB][aA][tT]|"$windows_mount_root"/[a-zA-Z]/*) return 0 ;;
    esac
    while IFS= read -r mount; do
        [ -n "$mount" ] || continue
        case $1 in "$mount"|"$mount"/*) return 0 ;; esac
    done <<EOF
$windows_mounts
EOF
    return 1
}
resolve_native_cli() {
    cli=$1
    old_ifs=$IFS
    IFS=:
    for directory in $PATH; do
        case $directory in /*) ;; *) continue ;; esac
        candidate=$directory/$cli
        is_windows_path "$candidate" && continue
        if [ -f "$candidate" ] && [ -x "$candidate" ]; then
            resolved=$(readlink -f "$candidate") || continue
            [ -n "$resolved" ] || continue
            is_windows_path "$resolved" && continue
            IFS=$old_ifs
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    IFS=$old_ifs
    printf '%s not found. Install it on this system (inside WSL on Windows); a Windows-side %s cannot use these logins.\n' "$cli" "$cli" >&2
    return 1
}
# The terminal UI runs the same engine as this launcher, wherever the UI binary itself was found.
: "${AIC_ENGINE:=$binary}"
export AIC_ENGINE
if [ "${1:-}" = "tui" ] && [ $# -eq 1 ]; then
    if [ -x "$here/aic-tui" ]; then exec "$here/aic-tui"; fi
    exec aic-tui
fi
if [ $# -eq 0 ]; then
    if [ "$(uname -s)" = "Linux" ]; then
        if [ -x "$here/aic-tui" ]; then exec "$here/aic-tui"; fi
        exec aic-tui
    fi
    nohup "$binary" >/dev/null 2>&1 &
    echo "AI Control is running in the menu bar."
    exit 0
fi
if [ "$1" = "login" ] && { [ $# -eq 2 ] || [ $# -eq 3 ]; }; then
    # claude auth login keeps the previous login valid; re-save it first so its latest refresh is kept.
    native_claude=$(resolve_native_cli claude) || exit 1
    "$binary" claude-login checkpoint
    if [ $# -eq 3 ]; then "$native_claude" auth login --claudeai --email "$3"; else "$native_claude" auth login --claudeai; fi
    exec "$binary" claude-login save "$2"
fi
if [ "$1" = "usage" ]; then exec "$binary" usage; fi
if [ "$1" = "settings" ] || [ "$1" = "auto-switch" ]; then exec "$binary" "$@"; fi
if [ "$1" = "status" ]; then
    shift
    if [ "${1:-}" = "--json" ]; then shift; fi
    exec "$binary" status --json "$@"
fi
if [ "$1" = "codex" ]; then
    shift
    if [ "${1:-}" = "login" ] && [ $# -eq 2 ]; then
        # codex login revokes the login in auth.json, so save it and clear the file first.
        native_codex=$(resolve_native_cli codex) || exit 1
        "$binary" codex-login prepare-login
        "$native_codex" login
        exec "$binary" codex-login save "$2"
    fi
    exec "$binary" codex-login "$@"
fi
exec "$binary" claude-login "$@"
