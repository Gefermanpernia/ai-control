#!/bin/sh
# Builds "AI Control.app" from an optimized build and zips it into dist/.
#   scripts/package-app <version>
set -eu
version=${1:-0.0.0}
cd "$(dirname "$0")/.."

swift build -c release --product AIControl
binary="$(swift build -c release --show-bin-path)/AIControl"

app="dist/AI Control.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/AIControl"
cp scripts/aic "$app/Contents/Resources/aic"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>AIControl</string>
    <key>CFBundleIdentifier</key><string>io.github.gefermanpernia.aicontrol</string>
    <key>CFBundleName</key><string>AI Control</string>
    <key>CFBundleDisplayName</key><string>AI Control</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>MIT License</string>
</dict>
</plist>
PLIST
# Ad-hoc signature: the app is not notarized, so macOS asks once before the first launch.
codesign --force --sign - "$app"
ditto -c -k --keepParent "$app" "dist/AI-Control-$version.zip"
echo "Built dist/AI-Control-$version.zip"
